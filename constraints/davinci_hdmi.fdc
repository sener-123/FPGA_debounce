# Board: ALIENTEK Davinci Pro Logos2
# FPGA: PG2L200H-6IFBB484; PDS device PG2L200H, speed -6, package FBB484.
# Top: davinci_hdmi_top; physical pins: 25.
# Source: board manual V1.0 pp.84-90, 677, 1156-1158.
# Load ONLY this pin file for this top, plus davinci_clocks.sdc and IP timing.
# Do not also load debounce.fdc or the other davinci pin file.
# Locations are FPGA package balls, NOT connector pin numbers.
# Debug ports stay internal. CAMERA_SGM changes AB18 function, not location.

# --- System clock / reset ---
define_attribute {p:sys_clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:sys_clk} {PAP_IO_LOC} {R4}
define_attribute {p:sys_clk} {PAP_IO_VCCIO} {1.5}
define_attribute {p:sys_clk} {PAP_IO_STANDARD} {LVCMOS15}
define_attribute {p:sys_rst_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:sys_rst_n} {PAP_IO_LOC} {U7}
define_attribute {p:sys_rst_n} {PAP_IO_VCCIO} {1.5}
define_attribute {p:sys_rst_n} {PAP_IO_STANDARD} {LVCMOS15}

