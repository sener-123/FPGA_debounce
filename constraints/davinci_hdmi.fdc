# Camera PCLK is fixed by the PCB at U18, a shared IO rather than the
# dedicated clock-source placement expected by PDS (Place-0084).
# Permit the IO-to-clock-network connection through general routing.
# Keep downstream global clock buffering; inspect routed timing/skew.
define_attribute {n:cam_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}
